# ==============================================================================
# QuickPrint Environment Variables Configuration
# Copy this file to .env.local and update with your own API credentials
# ==============================================================================

# --- Firebase Configuration (Merchant Authentication) ---
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""

# --- Supabase Configuration (Postgres Database, Realtime CDC & Document Storage) ---
# Find in your Supabase Dashboard: Project Settings -> API Keys
# Modern Publishable Key format (recommended):
VITE_SUPABASE_URL="https://your-project-ref.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_..."
# Legacy Anon Key format (also supported as fallback):
# VITE_SUPABASE_ANON_KEY="eyJhbGciOi..."

# --- Cloudflare Real-Time Relay (P2P WebSocket Fast-Lane) ---
# Deploy cloudflare-worker/ and paste your worker's *.workers.dev URL here
VITE_CF_RELAY_URL="wss://quickprint-relay.your-subdomain.workers.dev"
