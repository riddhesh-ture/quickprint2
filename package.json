{
  "name": "quickprint",
  "private": true,
  "version": "2.0.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build",
    "electron:dev": "electron .",
    "electron:start": "electron .",
    "electron:build": "vite build && electron-builder --win --dir",
    "lint": "eslint .",
    "test": "node --test tests/*.test.js",
    "test:daemon": "cd print-server && npm test",
    "daemon": "node print-server/src/index.js",
    "daemon:build-exe": "node scripts/build-exe.js",
    "preview": "vite preview"
  },
  "dependencies": {
    "@emotion/react": "^11.11.4",
    "@emotion/styled": "^11.11.5",
    "@mui/icons-material": "^9.4.0",
    "@mui/material": "^9.4.0",
    "@supabase/supabase-js": "^2.86.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "firebase": "^10.12.2",
    "html5-qrcode": "^2.3.8",
    "mammoth": "^1.13.0",
    "pdf-lib": "^1.17.1",
    "qrcode.react": "^3.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-dropzone": "^14.2.3",
    "react-pdf": "^9.2.1",
    "react-router-dom": "^6.23.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.34.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.7",
    "vite": "^8.3.1"
  },
  "build": {
    "appId": "com.quickprint.merchant",
    "productName": "QuickPrint",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "SumatraPDF.exe",
        "to": "SumatraPDF.exe"
      }
    ],
    "win": {
      "artifactName": "QuickPrint.exe",
      "target": [
        "portable"
      ]
    }
  }
}
